# 登录按钮的截图
SCREENSHOT_B64 = ""

def b64_to_image(b64_str):
    raw = base64.b64decode(b64_str)
    return Image.open(io.BytesIO(raw)).convert("RGB")

login_img = b64_to_image(SCREENSHOT_B64)

# 找登录按钮，如果找不到就是英语老师在拖堂，把希沃白板关掉了，或者希沃没退出登录
try:
    loc = agui.locateOnScreen(login_img, confidence=0.9)
    center = agui.center(loc)
    agui.click(center)

except agui.ImageNotFoundException:
    exit()

